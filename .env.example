# Entrega do formulário de contato.
#
# Sem RESEND_API_KEY e CONTACT_FROM_EMAIL, o formulário RECUSA o envio e informa o
# visitante de que a mensagem não foi registrada. Nunca exibe confirmação sem entrega.
# Copie para .env.local em desenvolvimento; em produção, configure na Vercel.

RESEND_API_KEY=
CONTACT_FROM_EMAIL=site@blackhill.com.br
CONTACT_TO_EMAIL=mchiara@blackhillcapital.com.br

# Google Search Console — propriedade por prefixo de URL.
# Preencha com o token que o Google fornece ("Tag HTML") e a meta aparece no
# <head>. Vazio, nada é emitido. Uma propriedade de domínio é preferível, mas
# exige um registro TXT no DNS.
GOOGLE_SITE_VERIFICATION=
